# Copy this file to .env (in this folder) and fill in your own key. Never commit .env.
# The backend reads PORTKEY_API_KEY from the environment; it is never printed or logged.
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: Portkey's OpenAI-compatible endpoint (this is already the default).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# The model is fixed in backend/main.py (gpt-6-luna) and is not read from this file.
